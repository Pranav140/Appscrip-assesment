# =============================================================================
# Real-Time Operations Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rtops
POSTGRES_USER=rtops
POSTGRES_PASSWORD=rtops_dev_password
DATABASE_URL=postgresql://rtops:rtops_dev_password@localhost:5432/rtops

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# Static bearer token for operator API access (replace with a strong secret)
OPERATOR_TOKEN=dev-operator-token-change-in-prod
# Admin token for device registration endpoint
ADMIN_TOKEN=dev-admin-token-change-in-prod

# ── Queue / Backpressure ──────────────────────────────────────────────────────
# Reject new ingest when queue depth exceeds this
HIGH_WATERMARK=5000
# Hard limit for readyz check
HARD_WATERMARK=10000
# Seconds before an in-flight event's lease expires and can be re-claimed
EVENT_LEASE_SECONDS=30
# Max attempts before an event is marked 'failed'
MAX_ATTEMPTS=5

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=30

# ── Silence / Device Status ───────────────────────────────────────────────────
STALE_AFTER_SECONDS=30
OFFLINE_AFTER_SECONDS=90
SCHEDULER_INTERVAL_MS=5000
# Grace period on startup before silence rules fire (prevents mass alerts after downtime)
STARTUP_GRACE_SECONDS=180

# ── Replay Detection ──────────────────────────────────────────────────────────
# Events older than this (received_at - event_ts) are flagged as replays
REPLAY_THRESHOLD_SECONDS=120
# Events with ts more than this many seconds in the future are rejected
MAX_FUTURE_SECONDS=86400

# ── Notifications ─────────────────────────────────────────────────────────────
MAX_NOTIFY_ATTEMPTS=8
NOTIFY_WEBHOOK_URL=http://localhost:4000/notify
# Circuit breaker: open after K consecutive failures
CIRCUIT_BREAKER_K=5
# Circuit breaker cool-off period in seconds
CIRCUIT_BREAKER_COOL_OFF_SECONDS=60

# ── Rule Engine ───────────────────────────────────────────────────────────────
RULE_CACHE_TTL_MS=5000
# Set to 'true' to write rule_evaluations rows for ALL rules, not just matches
TRACE_ALL_EVALUATIONS=false

# ── Simulator ────────────────────────────────────────────────────────────────
SIMULATOR_API_URL=http://localhost:3000
SIMULATOR_DEVICES=5
SIMULATOR_RATE=1

# ── Webhook Sink ─────────────────────────────────────────────────────────────
WEBHOOK_SINK_PORT=4000

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
